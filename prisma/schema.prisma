  createdByUser   User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  order           Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([productionId])
}

model UserInvite {
