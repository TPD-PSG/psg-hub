generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // url lives in prisma.config.ts (Prisma 7)
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("member") // admin | member | client | freelancer
  preferences  String? // JSON: { widgets: string[] }
  permissions  String? // JSON: { modules: string[], allProductions: boolean }
  avatarUrl    String?
  color        String? // hex colour for schedule grid badge
  costDayRate  Float? // internal cost per day, for job costing (admins set it)
  homeEntityId Int? // the company this person works for; its space (if any) is their home page
  homeEntity   Entity?  @relation("UserHomeEntity", fields: [homeEntityId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasksAssigned       Task[]              @relation("TaskAssignee")
  tasksSignoff        Task[]              @relation("TaskSignoff")
  tasksCreated        Task[]              @relation("TaskCreatedBy")
  notifications       Notification[]
  funSubmissions      FunSubmission[]
  productionTeams     ProductionTeam[]
  roadmapItems        RoadmapItem[]
  staffAssignments    StaffAssignment[]
  helpTicketsCreated  HelpTicket[]        @relation("TicketCreator")
  helpTicketsAssigned HelpTicket[]        @relation("TicketAssignee")
  expensesSubmitted   ProductionExpense[] @relation("ExpenseSubmitter")
  marketingPosts      MarketingPost[]     @relation("MarketingPostCreator")
  showReports         ShowReport[]        @relation("ShowReportCreatedBy")
  variationsRequested BudgetVariation[]   @relation("VariationRequester")
  variationsApproved  BudgetVariation[]   @relation("VariationApprover")
  productionNotes     ProductionNote[]
  meetings            Meeting[]
  opportunitiesOwned  Opportunity[]       @relation("OpportunityOwner")
  quotesCreated       Quote[]             @relation("QuoteCreatedBy")
  jobCostsCreated     JobCost[]           @relation("JobCostCreatedBy")
  timeEntries         TimeEntry[]         @relation("TimeEntryUser")
  bdActivities        BDActivity[]        @relation("BDActivityUser")
  targetClients       Client[]            @relation("ClientTargetOwner")
  buildParts          BuildPart[]         @relation("BuildParts")
  posRaised           PurchaseOrder[]     @relation("PORaisedBy")
  posApproved         PurchaseOrder[]     @relation("POApprovedBy")
  stockMoves          StockMove[]         @relation("StockMoveUser")
  spacePosts          SpacePost[]         @relation("SpacePostAuthor")
  spacePhotos         SpacePhoto[]        @relation("SpacePhotoUploader")
  buildVotes          BuildVote[]         @relation("BuildVotes")
}

model Production {
  id                  Int          @id @default(autoincrement())
  name                String
  logoUrl             String?
  type                String
  venue               String? // freetext fallback / override
  venueId             Int?
  venueRef            Venue?       @relation(fields: [venueId], references: [id], onDelete: SetNull)
  isTour              Boolean      @default(false)
  startDate           DateTime?
  endDate             DateTime?
  status              String       @default("planning")
  announcementStatus  String       @default("not_announced")
  internalStatus      String       @default("pencil") // pencil | confirmed
  archived            Boolean      @default(false)
  archivedAt          DateTime?
  productionManager   String? // free-text proj lead(s), e.g. "Toby / Tom"
  color               String?
  notes               String?
  contactSections     String? // JSON list of this production's own contact-sheet sections
  reportEmail         String?
  sharepointUrl       String?
  haulageBudgetLineId Int?
  advancingStatus     String       @default("triage")
  contraEstimate      Float?
  contraActual        Float?
  bdClientId          Int?
  bdClient            Client?      @relation("ProductionBDClient", fields: [bdClientId], references: [id], onDelete: SetNull)
  entityId            Int?
  entity              Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)
  pmFee               Float? // PM fee for this show; FeeStage rows split it into payments
  feeStages           FeeStage[]
  fromOpportunity     Opportunity? @relation("OpportunityProduction")
  job                 Job?
  builds              Job[]        @relation("JobForProduction")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  events               Event[]
  keyDates             ProductionKeyDate[]
  budgetLines          BudgetLine[]
  budgetVariations     BudgetVariation[]
  crew                 ProductionCrew[]
  hotelBookings        HotelBooking[]
  haulageMovements     HaulageMovement[]
  callSheets           CallSheet[]
  tasks                Task[]
  taskLists            TaskList[]
  team                 ProductionTeam[]
  tourStops            TourStop[]
  staffAssignments     StaffAssignment[]
  expenses             ProductionExpense[]
  marketingPosts       MarketingPost[]
  invoiceTodos         InvoiceTodo[]             @relation("InvoiceTodos")
  contacts             ProductionContact[]
  showReports          ShowReport[]
  productionDocuments  ProductionDocument[]
  productionLinks      ProductionLink[]
  hsDocuments          HSDocument[]
  toolboxSignatures    ToolboxTalkSignature[]
  performanceSchedule  PerformanceSchedule?
  performanceOverrides PerformanceDateOverride[]
  productionNotes      ProductionNote[]
  meetings             Meeting[]
}

model PerformanceSchedule {
  id             Int        @id @default(autoincrement())
  productionId   Int        @unique
  production     Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  // Bitmask: bit 0=Mon, 1=Tue, 2=Wed, 3=Thu, 4=Fri, 5=Sat, 6=Sun
  weekPattern    Int        @default(0)
  matineePattern Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model PerformanceDateOverride {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  date         String // YYYY-MM-DD
  type         String // "add" | "remove" | "matinee_add" | "matinee_remove"
  createdAt    DateTime   @default(now())
}

model ProductionLink {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  title        String
  url          String
  description  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model ProductionDocument {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  name         String
  mime         String
  data         String // base64
  fileKey      String? // object key in R2 (files/…); when set the bytes live there and the base64 column is ""
  folder       String     @default("General")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model ShowReport {
  id                Int        @id @default(autoincrement())
  productionId      Int
  production        Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  reportDate        DateTime
  venue             String?
  performance       String? // e.g. "Evening – 7:30pm"
  performanceNumber Int? // show number e.g. 81
  attendance        Int?
  houseCapacity     Int?
  runningTime       String? // e.g. "2:24"
  playingTime       String? // e.g. "2:03"
  notes             String? // structured summary from Claude
  flags             String? // JSON array of flagged section headings e.g. ["Technical – Sound","H&S"]
  emailSubject      String?
  emailFrom         String?
  productionMatched Boolean    @default(true)
  rawPdf            String? // base64 of original PDF
  pdfKey            String? // object key in R2 for the original PDF; when set, rawPdf is null
  createdByUserId   Int?
  createdByUser     User?      @relation("ShowReportCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Event {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  title        String
  type         String
  startAt      DateTime
  endAt        DateTime
  location     String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model BudgetLine {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  department   String
  description  String
  nominalCode  String?
  budgeted     Float
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  expenses         Expense[]
  variationItems   BudgetVariationItem[]
  haulageMovements HaulageMovement[]
}

model BudgetVariation {
  id              Int        @id @default(autoincrement())
  productionId    Int
  production      Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  type            String // reallocation | additional_spend | saving
  status          String     @default("draft") // draft | pending_approval | approved | rejected
  title           String
  justification   String?
  clientRef       String? // client PO / email ref / sign-off code
  requestedById   Int?
  requestedBy     User?      @relation("VariationRequester", fields: [requestedById], references: [id])
  requestedAt     DateTime   @default(now())
  approvedById    Int?
  approvedBy      User?      @relation("VariationApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  items BudgetVariationItem[]
}

model BudgetVariationItem {
  id           Int             @id @default(autoincrement())
  variationId  Int
  variation    BudgetVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)
  budgetLineId Int
  budgetLine   BudgetLine      @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  amount       Float // positive = increase, negative = decrease
  note         String?
}

model HaulageMovement {
  id               Int         @id @default(autoincrement())
  productionId     Int
  production       Production  @relation(fields: [productionId], references: [id], onDelete: Cascade)
  haulageCompany   String
  driverName       String?
  vehicleInfo      String?
  fromLocation     String
  toLocation       String
  departureAt      DateTime
  arrivalAt        DateTime?
  cargo            String?
  notes            String?
  estimatedCost    Float?
  actualCost       Float?
  rechargeable     Boolean     @default(false)
  invoicedToClient Boolean     @default(false)
  budgetLineId     Int?
  budgetLine       BudgetLine? @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Hotel {
  id        Int      @id @default(autoincrement())
  name      String
  city      String?
  address   String?
  phone     String?
  email     String?
  website   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings HotelBooking[]
}

model HotelBooking {
  id             Int        @id @default(autoincrement())
  hotelId        Int
  hotel          Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  productionId   Int
  production     Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  crewId         Int?
  crew           Crew?      @relation(fields: [crewId], references: [id], onDelete: SetNull)
  guestName      String?
  roomType       String?
  roomNumber     String?
  checkIn        DateTime
  checkOut       DateTime
  ratePerNight   Float?
  totalCost      Float?
  confirmationNo String?
  isPaid         Boolean    @default(false)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Crew {
  id                 Int       @id @default(autoincrement())
  name               String
  discipline         String
  phone              String?
  email              String?
  company            String?
  isFreelance        Boolean   @default(true)
  insuranceProvider  String?
  insurancePolicyNo  String?
  insuranceExpiry    DateTime?
  insuranceCoverType String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  productions   ProductionCrew[]
  hotelBookings HotelBooking[]
}

model ProductionCrew {
  id           Int        @id @default(autoincrement())
  crewId       Int
  crew         Crew       @relation(fields: [crewId], references: [id], onDelete: Cascade)
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  role         String?
  startDate    DateTime?
  endDate      DateTime?
  dayRate      Float?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Client {
  id             Int           @id @default(autoincrement())
  name           String
  type           String // promoter | venue | council | broadcaster | corporate | other
  website        String?
  address        String?
  notes          String?
  billingName    String?
  billingAddress String?
  billingEmail   String?
  targetAccount  Boolean       @default(false) // an account we're actively going after
  targetOwnerId  Int?
  targetOwner    User?         @relation("ClientTargetOwner", fields: [targetOwnerId], references: [id], onDelete: SetNull)
  targetSource   String? // e.g. "Ammonite"
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  contacts       Contact[]
  opportunities  Opportunity[]
  productions    Production[]  @relation("ProductionBDClient")
  quotes         Quote[]
  jobs           Job[]
}

model Contact {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Opportunity {
  id          Int       @id @default(autoincrement())
  title       String
  type        String // production | event | scenic | rental | acquisition | fb | other
  stage       String    @default("lead") // lead | qualified | proposal | negotiating | won | lost
  value       Float?
  clientId    Int?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  description String?
  closeDate   DateTime?
  lostReason  String? // win or loss reason
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       BDTask[]

  // BD pipeline & revenue
  entityId       Int?
  entity         Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)
  ownerUserId    Int?
  owner          User?        @relation("OpportunityOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  probability    Int? // % this deal counts in the weighted pipeline; null = the stage's default
  followUpDate   DateTime?
  leadSource     String?
  competitor     String?
  stageChangedAt DateTime? // null = never changed since created (use createdAt)
  productionId   Int?         @unique // the production a won deal became
  production     Production?  @relation("OpportunityProduction", fields: [productionId], references: [id], onDelete: SetNull)
  activities     BDActivity[]
  quotes         Quote[]
  job            Job?

  @@index([entityId])
  @@index([ownerUserId])
}

// A company in the group (deals, productions and revenue targets belong to one). Admins manage them.
model Entity {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  archived       Boolean         @default(false)
  sortOrder      Int             @default(0)
  // Its own space in the Hub (e.g. The Workshop Stoke): home page, colours and logo
  hasSpace       Boolean         @default(false)
  slug           String?         @unique // web address of the space, e.g. "tws" → /spaces/tws
  shortName      String? // e.g. "TWS"
  color          String? // theme colour, #rrggbb
  logoKey        String? // logo in R2…
  logoData       String? // …or in the database (base64) when R2 isn't set up
  logoMime       String?
  members        User[]          @relation("UserHomeEntity")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  opportunities  Opportunity[]
  productions    Production[]
  targets        RevenueTarget[]
  quotes         Quote[]
  quoteTemplates QuoteTemplate[]
  jobs           Job[]
  stockItems     StockItem[]
  purchaseOrders PurchaseOrder[]
  spacePosts     SpacePost[]
  spacePhotos    SpacePhoto[]
  buildVotes     BuildVote[]
}

// An entity's revenue target for a calendar year
model RevenueTarget {
  id       Int    @id @default(autoincrement())
  entityId Int
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  year     Int
  amount   Float

  @@unique([entityId, year])
}

// What happened on a deal: notes, calls, emails, meetings, and stage changes (logged automatically)
model BDActivity {
  id            Int         @id @default(autoincrement())
  opportunityId Int
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId        Int?
  user          User?       @relation("BDActivityUser", fields: [userId], references: [id], onDelete: SetNull)
  kind          String      @default("note") // note | call | email | meeting | stage
  text          String
  at            DateTime    @default(now())

  @@index([opportunityId, at])
}

// A production's PM fee, split into payment stages (deposit, fit-up, opening by default)
model FeeStage {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  label        String
  amount       Float
  dueDate      DateTime?
  invoicedAt   DateTime?
  paidAt       DateTime?
  sortOrder    Int        @default(0)

  @@index([productionId])
}

model BDTask {
  id            Int         @id @default(autoincrement())
  opportunityId Int
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  description   String
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Venue {
  id              Int             @id @default(autoincrement())
  name            String
  type            String // theatre | arena | outdoor | club | conference | other
  city            String?
  address         String?
  postcode        String?
  phone           String?
  email           String?
  website         String?
  capacity        Int?
  techNotes       String?
  techSpecs       String? // JSON: structured technical advancing data
  techSpecFile    String? // base64 encoded
  techSpecFileKey String? // object key in R2 for the tech-spec file; when set, techSpecFile is null
  techSpecName    String?
  techSpecMime    String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  contacts        VenueContact[]
  productions     Production[]
  tourStops       TourStop[]
  documents       VenueDocument[]
  dropOff         VenueDropOff?

  @@index([updatedAt])
}

// Haulage drop-off details. Night Run owns these and pushes them here; PSG Hub shows them read-only.
model VenueDropOff {
  id              Int      @id @default(autoincrement())
  venueId         Int      @unique
  venue           Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  loadingAddress  String?
  loadingPostcode String?
  what3words      String?
  accessTimes     String?
  maxVehicle      String?
  heightLimitMm   Int?
  widthLimitMm    Int?
  dockNotes       String?
  unloadingNotes  String?
  forkliftOnSite  Boolean?
  parkingNotes    String?
  emissionZone    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
}

model VenueDocument {
  id        Int      @id @default(autoincrement())
  venueId   Int
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  file      String // base64 encoded
  fileKey   String? // object key in R2 (files/…); when set the bytes live there and the base64 column is ""
  createdAt DateTime @default(now())
}

model TourStop {
  id               Int               @id @default(autoincrement())
  productionId     Int
  production       Production        @relation(fields: [productionId], references: [id], onDelete: Cascade)
  venueId          Int
  venue            Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  stopNumber       Int               @default(0)
  advancingStatus  String            @default("triage")
  contraEstimate   Float?
  contraActual     Float?
  loadInDate       DateTime?
  startDate        DateTime?
  endDate          DateTime?
  performanceStart DateTime?
  performanceEnd   DateTime?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  staffAssignments StaffAssignment[]
}

model VenueContact {
  id        Int      @id @default(autoincrement())
  venueId   Int
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CallSheet {
  id           Int              @id @default(autoincrement())
  productionId Int
  production   Production       @relation(fields: [productionId], references: [id], onDelete: Cascade)
  date         DateTime
  title        String?
  venue        String?
  generalNotes String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  entries      CallSheetEntry[]
}

model CallSheetEntry {
  id          Int       @id @default(autoincrement())
  callSheetId Int
  callSheet   CallSheet @relation(fields: [callSheetId], references: [id], onDelete: Cascade)
  discipline  String
  name        String?
  role        String?
  callTime    String?
  notes       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProductionTeam {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  userId       Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([productionId, userId])
}

model TaskList {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  name         String
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  tasks        Task[]
}

model Task {
  id              Int         @id @default(autoincrement())
  title           String
  description     String?
  productionId    Int?
  production      Production? @relation(fields: [productionId], references: [id], onDelete: Cascade)
  taskListId      Int?
  taskList        TaskList?   @relation(fields: [taskListId], references: [id], onDelete: SetNull)
  assigneeUserId  Int?
  assigneeUser    User?       @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assigneeName    String? // free-text if no user account
  status          String      @default("todo") // todo | in_progress | awaiting_signoff | done
  priority        String      @default("medium") // low | medium | high
  dueDate         DateTime?
  requiresSignoff Boolean     @default(false)
  signoffUserId   Int?
  signoffUser     User?       @relation("TaskSignoff", fields: [signoffUserId], references: [id], onDelete: SetNull)
  signoffAt       DateTime?
  meetingId       Int? // the meeting whose minutes this action came from
  meeting         Meeting?    @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  createdByUserId Int?
  createdByUser   User?       @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([productionId])
  @@index([assigneeUserId])
  @@index([createdByUserId])
  @@index([meetingId])
  @@index([status])
}

model FunRoundup {
  id          Int             @id @default(autoincrement())
  monthYear   String          @unique // "2026-11"
  sentAt      DateTime
  createdAt   DateTime        @default(now())
  submissions FunSubmission[]
}

model FunSubmission {
  id        Int         @id @default(autoincrement())
  authorId  Int
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  story     String
  monthYear String // "2026-11" — the month it was submitted
  approved  Boolean     @default(false)
  roundupId Int?
  roundup   FunRoundup? @relation(fields: [roundupId], references: [id], onDelete: SetNull)
  media     FunMedia[]
  createdAt DateTime    @default(now())
}

model FunMedia {
  id           Int           @id @default(autoincrement())
  submissionId Int
  submission   FunSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  name         String
  mime         String
  data         String? // base64 (legacy — null for file-system-stored media)
  filePath     String? // path on disk relative to MEDIA_DIR
  createdAt    DateTime      @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

model Expense {
  id               Int        @id @default(autoincrement())
  budgetLineId     Int
  budgetLine       BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  phase            String     @default("pre-production") // pre-production, running, closing
  description      String
  estimated        Float      @default(0)
  committed        Float      @default(0)
  spent            Float      @default(0)
  poNumber         String?
  paymentDue       DateTime?
  issuedForPayment Boolean    @default(false)
  vatExempt        Boolean    @default(false)
  supplier         String?
  notes            String?
  approvedBy       String?
  approvedDate     DateTime?
  approvalMethod   String?
  isPSGExpense     Boolean    @default(false)
  invoicedToClient Boolean    @default(false)
  paymentMethod    String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  documents SpendDocument[]
}

