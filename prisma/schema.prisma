  token         String    @unique
  email         String
  name          String
  role          String    @default("member")
  permissions   String?
  productionIds String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
}

// ── Quotes & job costing ────────────────────────────────────────────────────────

// A priced quote for a piece of work. Lines carry our cost and the sell price, so margin is
// known before it goes out. Accepted quotes become the job's price.
model Quote {
  id            Int          @id @default(autoincrement())
  number        String       @unique // Q-2026-001
  title         String
  jobType       String       @default("pm") // pm | workshop | haulage | other
  status        String       @default("draft") // draft | sent | accepted | declined
  entityId      Int?
  entity        Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)
  clientId      Int?
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  opportunityId Int?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  jobId         Int?
  job           Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  vatRate       Float        @default(20)
  validUntil    DateTime?
  terms         String? // shown on the PDF
  internalNotes String? // never on the PDF
  sentAt        DateTime?
  decidedAt     DateTime?
  createdById   Int?
  createdBy     User?        @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  lines         QuoteLine[]

  @@index([opportunityId])
  @@index([jobId])
}

model QuoteLine {
  id          Int     @id @default(autoincrement())
  quoteId     Int
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  section     String? // e.g. Pre-production, Fit-up, Running
  description String
  quantity    Float   @default(1)
  unit        String? // day, week, each…
  unitCost    Float   @default(0) // what it costs us
  unitPrice   Float   @default(0) // what we charge
  sortOrder   Int     @default(0)

  @@index([quoteId])
}

// A reusable starting point for quotes (lines as JSON). Saved from any quote.
model QuoteTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  jobType   String   @default("pm")
  entityId  Int?
  entity    Entity?  @relation(fields: [entityId], references: [id], onDelete: SetNull)
  lines     String // JSON: [{ section, description, quantity, unit, unitCost, unitPrice }]
  terms     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A piece of work we're doing: a PM job (linked to its production), a Workshop build, a Night
// Run move… Costs and staff time are logged against it; its price comes from the accepted quote.
model Job {
  id              Int             @id @default(autoincrement())
  number          String          @unique // J-2026-001
  title           String
  jobType         String          @default("pm")
  status          String          @default("active") // active | complete | cancelled
  entityId        Int?
  entity          Entity?         @relation(fields: [entityId], references: [id], onDelete: SetNull)
  clientId        Int?
  client          Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  opportunityId   Int?            @unique
  opportunity     Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  productionId    Int?            @unique
  production      Production?     @relation(fields: [productionId], references: [id], onDelete: SetNull)
  price           Float? // agreed price if there's no accepted quote
  startDate       DateTime?
  endDate         DateTime?
  notes           String?
  // Build stages (workshop jobs): quote → confirmation → technical_design → build → finish → delivery
  stage           String?
  stageChangedAt  DateTime?
  deliveryMethod  String? // collection | delivery
  deliveryNotes   String? // address, access, contact
  forProductionId Int? // the show a build is for (a show can have a PM job and builds)
  forProduction   Production?     @relation("JobForProduction", fields: [forProductionId], references: [id], onDelete: SetNull)
  links           JobLink[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  quotes          Quote[]
  costs           JobCost[]
  time            TimeEntry[]
  parts           BuildPart[]
  purchaseOrders  PurchaseOrder[]
  stockMoves      StockMove[]
  spacePosts      SpacePost[]
  photos          SpacePhoto[]
  buildVotes      BuildVote[]
}

model JobCost {
  id          Int      @id @default(autoincrement())
  jobId       Int
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  date        DateTime
  description String
  supplier    String?
  category    String? // materials, hire, transport, subcontract, other
  amount      Float // net of VAT
  createdById Int?
  createdBy   User?    @relation("JobCostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([jobId])
}

// Days a person spent on a job, costed at their day rate at the time (so later rate changes
// don't rewrite past jobs' margins)
model TimeEntry {
  id        Int      @id @default(autoincrement())
  jobId     Int
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  days      Float // 0.5 steps
  dayRate   Float? // the person's cost rate when logged
  note      String?
  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([userId, date])
}

// A file a job uses, kept where it lives (OneDrive/SharePoint): VectorWorks drawings, cut lists…
model JobLink {
  id        Int      @id @default(autoincrement())
  jobId     Int
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  label     String
  url       String
  kind      String   @default("vectorworks") // vectorworks | drawing | other
  createdAt DateTime @default(now())

  @@index([jobId])
}

// TWS planner: a part of a build (e.g. "Truck frames"), who's doing it and when. A part with no
// person or start date waits in the planner's "To plan" tray.
model BuildPart {
  id        Int       @id @default(autoincrement())
  jobId     Int
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  label     String
  userId    Int?
  user      User?     @relation("BuildParts", fields: [userId], references: [id], onDelete: SetNull)
  startDate DateTime? // midnight UTC of the first day
  days      Int       @default(1) // consecutive calendar days
  hours     Float? // planned hours
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([jobId])
  @@index([userId, startDate])
}

// TWS materials & kit: what the workshop holds, per company (space)
model StockItem {
  id           Int                 @id @default(autoincrement())
  entityId     Int
  entity       Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name         String
  unit         String              @default("each") // sheets, lengths, L, each…
  quantity     Float               @default(0)
  reorderLevel Float? // at or below this it shows as low
  unitCost     Float? // ex VAT, for costing what's booked out to jobs
  supplierId   Int?
  supplier     Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  location     String?
  archived     Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  moves        StockMove[]
  poLines      PurchaseOrderLine[]

  @@index([entityId])
}

// Every change to a stock level: deliveries (from POs), booked out to a job, returns, counts
model StockMove {
  id        Int            @id @default(autoincrement())
  itemId    Int
  item      StockItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  change    Float // + in, - out
  kind      String // delivery | book_out | return | adjust
  jobId     Int?
  job       Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  poId      Int?
  po        PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  unitCost  Float? // the item's cost when it moved
  note      String?
  userId    Int?
  user      User?          @relation("StockMoveUser", fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())

  @@index([itemId])
  @@index([jobId])
}

// Purchase orders: draft → awaiting_approval (over the limit) / approved → ordered → delivered; or cancelled
model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  number       String              @unique // PO-2026-001
  entityId     Int?
  entity       Entity?             @relation(fields: [entityId], references: [id], onDelete: SetNull)
  jobId        Int?
  job          Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  supplierId   Int?
  supplier     Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName String? // when the supplier isn't in the Hub's list
  status       String              @default("draft")
  notes        String?
  raisedById   Int?
  raisedBy     User?               @relation("PORaisedBy", fields: [raisedById], references: [id], onDelete: SetNull)
  approvedById Int?
  approvedBy   User?               @relation("POApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  orderedAt    DateTime?
  deliveredAt  DateTime?
  inSage       Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  lines        PurchaseOrderLine[]
  stockMoves   StockMove[]

  @@index([jobId])
  @@index([entityId, status])
}

model PurchaseOrderLine {
  id          Int           @id @default(autoincrement())
  poId        Int
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  description String
  quantity    Float         @default(1)
  unit        String?
  unitCost    Float         @default(0) // ex VAT
  stockItemId Int? // delivered quantity goes into this stock item
  stockItem   StockItem?    @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  sortOrder   Int           @default(0)
}

// TWS noticeboard: notices, photos and showcases posted in a company space
model SpacePost {
  id        Int          @id @default(autoincrement())
  entityId  Int
  entity    Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  authorId  Int?
  author    User?        @relation("SpacePostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  kind      String       @default("notice") // notice | photo | showcase
  title     String?
  body      String?
  jobId     Int?
  job       Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  pinned    Boolean      @default(false)
  createdAt DateTime     @default(now())
  photos    SpacePhoto[]

  @@index([entityId, createdAt])
}

// A photo in a space: of a build (jobId), on a noticeboard post (postId), or both once shared
model SpacePhoto {
  id           Int        @id @default(autoincrement())
  entityId     Int
  entity       Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  jobId        Int?
  job          Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  postId       Int?
  post         SpacePost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  uploadedById Int?
  uploadedBy   User?      @relation("SpacePhotoUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  fileKey      String?
  data         String? // base64 when file storage isn't set up
  mime         String
  caption      String?
  createdAt    DateTime   @default(now())

  @@index([jobId])
  @@index([entityId, createdAt])
}

// Build of the month: one vote per person per month in a space (can be changed until the month ends)
model BuildVote {
  id        Int      @id @default(autoincrement())
  entityId  Int
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  monthYear String // "2026-11"
  jobId     Int
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("BuildVotes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, monthYear, userId])
  @@index([entityId, monthYear])
}
