generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("member") // admin | member
  preferences  String?  // JSON: { widgets: string[] }
  permissions  String?  // JSON: { modules: string[], allProductions: boolean }
  avatarUrl    String?
  color        String?  // hex colour for schedule grid badge
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasksAssigned       Task[]           @relation("TaskAssignee")
  tasksSignoff        Task[]           @relation("TaskSignoff")
  tasksCreated        Task[]           @relation("TaskCreatedBy")
  notifications       Notification[]
  funSubmissions      FunSubmission[]
  productionTeams     ProductionTeam[]
  roadmapItems        RoadmapItem[]
  staffAssignments    StaffAssignment[]
  helpTicketsCreated  HelpTicket[]     @relation("TicketCreator")
  helpTicketsAssigned HelpTicket[]     @relation("TicketAssignee")
  expensesSubmitted   ProductionExpense[] @relation("ExpenseSubmitter")
  marketingPosts      MarketingPost[]    @relation("MarketingPostCreator")
  showReports         ShowReport[]       @relation("ShowReportCreatedBy")
}

model Production {
  id          Int       @id @default(autoincrement())
  name        String
  logoUrl     String?
  type        String
  venue       String?   // freetext fallback / override
  venueId     Int?
  venueRef    Venue?    @relation(fields: [venueId], references: [id], onDelete: SetNull)
  isTour      Boolean   @default(false)
  startDate   DateTime?
  endDate     DateTime?
  status              String    @default("planning")
  announcementStatus  String    @default("not_announced")
  color       String?
  notes         String?
  reportEmail   String?
  sharepointUrl String?
  haulageBudgetLineId Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  events      Event[]
  keyDates    ProductionKeyDate[]
  budgetLines BudgetLine[]
  crew        ProductionCrew[]
  hotelBookings     HotelBooking[]
  haulageMovements  HaulageMovement[]
  callSheets        CallSheet[]
  tasks             Task[]
  taskLists         TaskList[]
  team              ProductionTeam[]
  tourStops         TourStop[]
  staffAssignments  StaffAssignment[]
  expenses          ProductionExpense[]
  marketingPosts    MarketingPost[]
  invoiceTodos      InvoiceTodo[]      @relation("InvoiceTodos")
  contacts          ProductionContact[]
  showReports       ShowReport[]
  productionDocuments ProductionDocument[]
  productionLinks     ProductionLink[]
  hsDocuments         HSDocument[]
  toolboxSignatures   ToolboxTalkSignature[]
}

model ProductionLink {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  title        String
  url          String
  description  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model ProductionDocument {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  name         String
  mime         String
  data         String     // base64
  folder       String     @default("General")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model ShowReport {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  reportDate   DateTime
  venue        String?
  performance  String?    // e.g. "Evening - 7:30pm"
  attendance   Int?
  notes        String?
  createdByUserId Int?
  createdByUser   User?   @relation("ShowReportCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}


model Event {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  title        String
  type         String
  startAt      DateTime
  endAt        DateTime
  location     String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model BudgetLine {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  department   String
  description  String
  nominalCode  String?
  budgeted     Float
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  expenses     Expense[]
}

model HaulageMovement {
  id               Int        @id @default(autoincrement())
  productionId     Int
  production       Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  haulageCompany   String
  driverName       String?
  vehicleInfo      String?
  fromLocation     String
  toLocation       String
  departureAt      DateTime
  arrivalAt        DateTime?
  cargo            String?
  notes            String?
  estimatedCost    Float?
  actualCost       Float?
  rechargeable     Boolean    @default(false)
  budgetLineId     Int?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Hotel {
  id        Int            @id @default(autoincrement())
  name      String
  city      String?
  address   String?
  phone     String?
  email     String?
  website   String?
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  bookings  HotelBooking[]
}

model HotelBooking {
  id             Int        @id @default(autoincrement())
  hotelId        Int
  hotel          Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  productionId   Int
  production     Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  crewId         Int?
  crew           Crew?      @relation(fields: [crewId], references: [id], onDelete: SetNull)
  guestName      String?
  roomType       String?
  roomNumber     String?
  checkIn        DateTime
  checkOut       DateTime
  ratePerNight   Float?
  totalCost      Float?
  confirmationNo String?
  isPaid         Boolean    @default(false)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Crew {
  id                   Int              @id @default(autoincrement())
  name                 String
  discipline           String
  phone                String?
  email                String?
  company              String?
  isFreelance          Boolean          @default(true)
  insuranceProvider    String?
  insurancePolicyNo    String?
  insuranceExpiry      DateTime?
  insuranceCoverType   String?
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  productions          ProductionCrew[]
  hotelBookings        HotelBooking[]
}

model ProductionCrew {
  id           Int        @id @default(autoincrement())
  crewId       Int
  crew         Crew       @relation(fields: [crewId], references: [id], onDelete: Cascade)
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  role         String?
  startDate    DateTime?
  endDate      DateTime?
  dayRate      Float?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Client {
  id            Int           @id @default(autoincrement())
  name          String
  type          String        // promoter | venue | council | broadcaster | corporate | other
  website       String?
  address       String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  contacts      Contact[]
  opportunities Opportunity[]
}

model Contact {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Opportunity {
  id          Int       @id @default(autoincrement())
  title       String
  type        String    // production | event | scenic | rental | acquisition | fb | other
  stage       String    @default("lead") // lead | qualified | proposal | negotiating | won | lost
  value       Float?
  clientId    Int?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  description String?
  closeDate   DateTime?
  lostReason  String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       BDTask[]
}

model BDTask {
  id            Int         @id @default(autoincrement())
  opportunityId Int
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  description   String
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Venue {
  id          Int            @id @default(autoincrement())
  name        String
  type        String         // theatre | arena | outdoor | club | conference | other
  city        String?
  address     String?
  postcode    String?
  phone       String?
  email       String?
  website     String?
  capacity    Int?
  techNotes       String?
  techSpecs       String?   // JSON: structured technical advancing data
  techSpecFile    String?   // base64 encoded
  techSpecName    String?
  techSpecMime    String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  contacts        VenueContact[]
  productions     Production[]
  tourStops       TourStop[]
  documents       VenueDocument[]
}

model VenueDocument {
  id        Int      @id @default(autoincrement())
  venueId   Int
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  file      String   // base64 encoded
  createdAt DateTime @default(now())
}

model TourStop {
  id               Int        @id @default(autoincrement())
  productionId     Int
  production       Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  venueId          Int
  venue            Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  stopNumber       Int        @default(0)
  advancingStatus  String     @default("triage")
  contraEstimate   Float?
  contraActual     Float?
  loadInDate       DateTime?
  startDate        DateTime?
  endDate          DateTime?
  performanceStart DateTime?
  performanceEnd   DateTime?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  staffAssignments StaffAssignment[]
}

model VenueContact {
  id        Int      @id @default(autoincrement())
  venueId   Int
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CallSheet {
  id           Int              @id @default(autoincrement())
  productionId Int
  production   Production       @relation(fields: [productionId], references: [id], onDelete: Cascade)
  date         DateTime
  title        String?
  venue        String?
  generalNotes String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  entries      CallSheetEntry[]
}

model CallSheetEntry {
  id          Int        @id @default(autoincrement())
  callSheetId Int
  callSheet   CallSheet  @relation(fields: [callSheetId], references: [id], onDelete: Cascade)
  discipline  String
  name        String?
  role        String?
  callTime    String?
  notes       String?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ProductionTeam {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  userId       Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([productionId, userId])
}

model TaskList {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  name         String
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  tasks        Task[]
}

model Task {
  id              Int       @id @default(autoincrement())
  title           String
  description     String?
  productionId    Int?
  production      Production? @relation(fields: [productionId], references: [id], onDelete: Cascade)
  taskListId      Int?
  taskList        TaskList? @relation(fields: [taskListId], references: [id], onDelete: SetNull)
  assigneeUserId  Int?
  assigneeUser    User?     @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assigneeName    String?   // free-text if no user account
  status          String    @default("todo") // todo | in_progress | awaiting_signoff | done
  priority        String    @default("medium") // low | medium | high
  dueDate         DateTime?
  requiresSignoff Boolean   @default(false)
  signoffUserId   Int?
  signoffUser     User?     @relation("TaskSignoff", fields: [signoffUserId], references: [id], onDelete: SetNull)
  signoffAt       DateTime?
  createdByUserId Int?
  createdByUser   User?     @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model FunRoundup {
  id          Int             @id @default(autoincrement())
  monthYear   String          @unique // "2026-11"
  sentAt      DateTime
  createdAt   DateTime        @default(now())
  submissions FunSubmission[]
}

model FunSubmission {
  id          Int         @id @default(autoincrement())
  authorId    Int
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  story       String
  monthYear   String      // "2026-11" — the month it was submitted
  approved    Boolean     @default(false)
  roundupId   Int?
  roundup     FunRoundup? @relation(fields: [roundupId], references: [id], onDelete: SetNull)
  media       FunMedia[]
  createdAt   DateTime    @default(now())
}

model FunMedia {
  id           Int           @id @default(autoincrement())
  submissionId Int
  submission   FunSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  name         String
  mime         String
  data         String        // base64
  createdAt    DateTime      @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Expense {
  id                Int        @id @default(autoincrement())
  budgetLineId      Int
  budgetLine        BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  phase             String     @default("pre-production") // pre-production, running, closing
  description       String
  estimated         Float      @default(0)
  committed         Float      @default(0)
  spent             Float      @default(0)
  poNumber          String?
  paymentDue        DateTime?
  issuedForPayment  Boolean    @default(false)
  vatExempt         Boolean    @default(false)
  supplier          String?
  notes             String?
  approvedBy        String?
  approvedDate      DateTime?
  approvalMethod    String?
  isPSGExpense      Boolean    @default(false)
  paymentMethod     String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  documents         SpendDocument[]
}

model SpendDocument {
  id               Int      @id @default(autoincrement())
  expenseId        Int
  expense          Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  type             String   // quote | po | invoice
  name             String
  mime             String
  file             String   // base64
  invoiceDate      DateTime?
  invoiceAmount    Float?
  invoiceNumber    String?
  issuedForPayment Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model Property {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts     PropertyContact[]
  documents    PropertyDocument[]
  maintenance  PropertyMaintenance[]
  rent         PropertyRent?
  keys         PropertyKey[]
  alarms       PropertyAlarm[]
}

model PropertyContact {
  id         Int      @id @default(autoincrement())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  role       String
  phone      String?
  email      String?
  notes      String?
  createdAt  DateTime @default(now())
}

model PropertyDocument {
  id         Int       @id @default(autoincrement())
  propertyId Int
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  type       String    @default("other")
  expiryDate DateTime?
  fileUrl    String?
  notes      String?
  createdAt  DateTime  @default(now())
}

model PropertyMaintenance {
  id          Int       @id @default(autoincrement())
  propertyId  Int
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String    @default("reported")
  priority    String    @default("normal")
  contractor  String?
  cost        Float?
  reportedAt  DateTime  @default(now())
  resolvedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
}

model PropertyRent {
  id              Int      @id @default(autoincrement())
  propertyId      Int      @unique
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amount          Float?
  frequency       String?
  nextPaymentDate DateTime?
  nextReviewDate  DateTime?
  landlordRef     String?
  notes           String?
  updatedAt       DateTime @updatedAt
}

model PropertyKey {
  id          Int      @id @default(autoincrement())
  propertyId  Int
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  description String
  holder      String?
  quantity    Int      @default(1)
  notes       String?
  createdAt   DateTime @default(now())
}

model PropertyAlarm {
  id              Int      @id @default(autoincrement())
  propertyId      Int
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name            String
  code            String?
  zones           String?
  monitoringCo    String?
  monitoringPhone String?
  keyholders      String?
  notes           String?
  createdAt       DateTime @default(now())
}

model ProductionKeyDate {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  type         String     // design_presentation | pre_production | first_rehearsal | rehearsal_period | load_in | fit_up | technical_rehearsal | dress_rehearsal | preview | press_night | performance | get_out | other
  label        String?    // optional override label
  startDate    DateTime
  endDate      DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
}

model CompanyInvoice {
  id          Int       @id @default(autoincrement())
  type        String    // sales | purchase
  reference   String?
  description String
  party       String    // client (sales) or supplier (purchase)
  production  String?   // free-text production name, for context
  netAmount   Float     @default(0)
  vatAmount   Float     @default(0)
  issueDate   DateTime?
  dueDate     DateTime?
  status      String    @default("draft") // draft | sent | received | overdue | paid
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProductionExpense {
  id                Int        @id @default(autoincrement())
  production        String?    // free-text fallback (legacy)
  productionId      Int?
  productionLink    Production? @relation(fields: [productionId], references: [id], onDelete: SetNull)
  submittedByUserId Int?
  submittedByUser   User?      @relation("ExpenseSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  category          String     @default("misc") // travel | accommodation | marketing | props | costume | set | equipment | catering | venue | misc
  description       String
  supplier          String?
  netAmount         Float      @default(0)
  vatAmount         Float      @default(0)
  date              DateTime?
  paymentMethod     String?    @default("to_pay") // card | cash | transfer | to_pay
  status            String     @default("pending") // pending | approved | paid | rejected
  reference         String?
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model QuickLink {
  id    Int    @id @default(autoincrement())
  label String
  url   String
  icon  String @default("🔗")
  order Int    @default(0)
}

model StaffAssignment {
  id           Int        @id @default(autoincrement())
  userId       Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  tourStopId   Int?
  tourStop     TourStop?  @relation(fields: [tourStopId], references: [id], onDelete: SetNull)
  startDate    DateTime
  endDate      DateTime
  activityType String?    // GET IN | FIT UP | TECH | DRESS | PREVIEW | PERF | PERF+OUT | REH | IN | OUT | TBC
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model SalesBrand {
  id          Int          @id @default(autoincrement())
  name        String
  category    String       @default("lighting") // lighting | sound | cable | staging | rigging | video | consumables | other
  stage       String       @default("prospect")  // prospect | contacted | samples | negotiating | active | paused | lost
  website     String?
  rep         String?
  repEmail    String?
  repPhone    String?
  notes       String?
  priority    String       @default("medium")    // high | medium | low
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tasks       SalesTask[]
}

model SalesTask {
  id          Int          @id @default(autoincrement())
  title       String
  notes       String?
  dueDate     DateTime?
  completedAt DateTime?
  priority    String       @default("medium")    // high | medium | low
  brandId     Int?
  brand       SalesBrand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model KnowledgeDoc {
  id        Int      @id @default(autoincrement())
  name      String
  mime      String
  file      String   // base64 encoded
  createdAt DateTime @default(now())
}

model HelpTicket {
  id              Int       @id @default(autoincrement())
  title           String
  description     String?
  category        String    @default("bug")    // bug | feature | question | other
  priority        String    @default("medium") // low | medium | high | urgent
  status          String    @default("open")   // open | in_progress | resolved | closed
  createdByUserId Int?
  createdByUser   User?     @relation("TicketCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignedToUserId Int?
  assignedToUser  User?     @relation("TicketAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  category    String   @default("other") // venue | contractor | equipment | transport | catering | marketing | legal | insurance | other
  contactName String?
  email       String?
  phone       String?
  website     String?
  address     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InvoiceTodo {
  id           Int      @id @default(autoincrement())
  client       String
  description  String
  productionId Int?
  production   Production? @relation("InvoiceTodos", fields: [productionId], references: [id], onDelete: SetNull)
  amount       Float?
  dueDate      DateTime?
  notes        String?
  done         Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MarketingPost {
  id           Int      @id @default(autoincrement())
  title        String
  caption      String?
  platforms    String   @default("[]") // JSON array: "instagram" | "facebook" | "twitter" | "linkedin" | "tiktok"
  status       String   @default("draft") // draft | scheduled | published | cancelled
  scheduledAt  DateTime?
  publishedAt  DateTime?
  productionId Int?
  production   Production? @relation(fields: [productionId], references: [id], onDelete: SetNull)
  imageUrl     String?
  link         String?
  tags         String?  // comma-separated
  notes        String?
  createdByUserId Int?
  createdByUser   User?  @relation("MarketingPostCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RoadmapItem {
  id              Int      @id @default(autoincrement())
  title           String
  body            String?
  category        String   @default("general") // general | feature | improvement | bug | infrastructure
  status          String   @default("idea")    // idea | planned | in_progress | done | wont_do
  pinned          Boolean  @default(false)
  createdByUserId Int?
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProductionContact {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  section      String     @default("General")
  sortOrder    Int        @default(0)
  name         String
  company      String?
  role         String?
  phone        String?
  email        String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model HSDocument {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  name         String
  mime         String
  data         String
  tourStopId   Int?
  folder       String     @default("General")
  createdAt    DateTime   @default(now())
}

model ToolboxTalkSignature {
  id           Int        @id @default(autoincrement())
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  tourStopId   Int?
  venueName    String?
  signeeName   String
  signeeDate   String
  employer     String?
  position     String?
  signature    String
  agreedBriefing Boolean  @default(false)
  agreedSafety   Boolean  @default(false)
  createdAt    DateTime   @default(now())
}
